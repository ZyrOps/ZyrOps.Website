VITE_HRMS_BASE_URL=https://hrms.zyrops.com
VITE_HRMS_TENANT_ID=9
VITE_HRMS_API_KEY=your_api_key_here

# Hostinger SMTP — use mailbox email + password from hPanel
# Docs: smtp.hostinger.com · port 465 SSL (or 587 STARTTLS)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=hello@zyrops.com
SMTP_PASS=your_hostinger_mailbox_password
MAIL_FROM=hello@zyrops.com
MAIL_TO=hello@zyrops.com
MAIL_SEND_CONFIRMATION=true
PORT=3001
CORS_ORIGIN=https://zyrops.com
